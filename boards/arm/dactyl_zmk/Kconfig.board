config BOARD_DACTYL_ZMK_LEFT
    bool "dactyl-zmk left"
    depends on SOC_SERIES_YOUR_SOC_SERIES_HERE
    select SOC_PART_NUMBER_ABCDEFGH

config BOARD_DACTYL_ZMK_RIGHT
    bool "dactyl-zmk right"
    depends on SOC_SERIES_YOUR_SOC_SERIES_HERE
    select SOC_PART_NUMBER_ABCDEFGH
