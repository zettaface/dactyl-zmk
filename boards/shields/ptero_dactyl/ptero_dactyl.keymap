#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro

#define DEFAULT 0
#define AUTOSHIFTED 1
#define GAME    2
#define LNAVL   3
#define NUML    4
#define SYMBL   5
#define FUNCL   6
#define LOWER   7

/ {
    behaviors {
        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <145>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 38 39 41>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 40>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "def";
            bindings = <
&kp ESC    &kp Q        &kp W         &kp E                &kp R            &kp T                           &kp Y            &kp U         &kp I             &kp O       &kp P             &kp LBKT
&kp TAB    &hml LGUI A  &hml LALT S   &hml LSHFT D         &hml LCTRL F     &kp G                           &kp H            &hmr RCTRL J  &hmr RSHFT K      &hmr RALT L &hmr RGUI SEMI    &kp SQT
&kp LCTRL  &kp Z        &kp X         &kp C                &kp V            &kp B                           &kp N            &kp M         &kp COMMA         &kp DOT     &kp FSLH          &kp RBKT                                                                        
                                                           &lt LNAVL SPACE  &mo LNAVL                       &lt NUML ENTER   &mo FUNCL
                                                                            &kp BSPC                        &lt SYMBL DEL
            >;
        };

        as_layer {
            display-name = "sdef";
            bindings = <
&trans    AS(Q)      AS(W)     AS(E)      AS(R)      AS(T)                           AS(Y)      AS(U)      AS(I)      AS(O)      AS(P)          AS(LBKT)
&trans    AS(A)      AS(S)     AS(D)      AS(F)      AS(G)                           AS(H)      AS(J)      AS(K)      AS(L)      AS(SEMI)       AS(SQT)
&trans    AS(Z)      AS(X)     AS(C)      AS(V)      AS(B)                           AS(N)      AS(M)      AS(COMMA)  AS(DOT)    AS(FSLH)       AS(RBKT)                                                               
                                          &trans     &trans                          &trans     &trans
                                                     &trans                          &trans
            >;
        };

        game_layer {
            display-name = "game";
            bindings = <
&kp N1     &kp ESC    &kp Q      &kp W     &kp E      &kp R                                 &kp Y            &kp U      &kp I      &kp O      &kp P          &kp LBKT
&kp N2     &kp LSHIFT &kp A      &kp S     &kp D      &kp F                                 &kp H            &kp J      &kp K      &kp L      &kp SEMI       &kp SQT
&kp N3     &kp LCTRL  &kp Z      &kp X     &kp C      &kp V                                 &kp N            &kp M      &kp COMMA  &kp DOT    &kp FSLH       &kp RBKT                                                                            
                                           &kp SPACE  &mo LNAVL                             &lt SYMBL ENTER  &lt NUML ENTER 
                                                      &mo NUML                              &kp DEL          
            >;
        };

        lnavl {
            display-name = "nav";
            bindings = <
&bootloader  &trans    &trans    &trans     &trans     &trans                           &trans      &trans      &trans      &trans      &trans      &trans
&trans       &kp LEFT  &kp DOWN  &kp UP     &kp RIGHT  &trans                           &trans      &trans      &trans      &trans      &trans      &trans
&trans       &kp HOME  &kp PG_DN &kp PG_UP  &kp END    &trans                           &trans      &trans      &trans      &trans      &trans      &trans                                                                      
                                            &trans     &trans                           &trans      &trans      
                                                       &trans                           &trans      
            >;
        };

        numl {
            display-name = "num";
            bindings = <
&trans    &kp LBKT  &kp N7      &kp N8        &kp N9       &kp RBKT                           &trans      &trans      &trans      &trans      &trans      &trans
&trans    &trans    &kp N4      &kp N5        &kp N6       &kp EQUAL                        &trans      &trans      &trans      &trans      &trans      &trans
&trans    &trans    &kp N1      &kp N2        &kp N3       &kp BACKSLASH                    &trans      &trans      &trans      &trans      &trans      &trans                                                                     
                                              &kp N0       &kp DOT                          &trans      &trans      
                                                           &kp MINUS                         &trans      
            >;
        };

        symbl {
            display-name = "sym";
            bindings = <
&trans    &kp LBRC  &kp AMPS   &kp ASTRK    &kp LPAR    &kp RBRC                        &trans      &trans      &trans      &trans      &trans      &bootloader
&trans    &kp COLON &kp DLLR   &kp PRCNT    &kp CARET   &kp PLUS                        &trans      &trans      &trans      &trans      &trans      &trans
&trans    &trans    &kp EXCL   &kp AT       &kp POUND   &kp PIPE                        &trans      &trans      &trans      &trans      &trans      &trans                                                            
                                            &kp LBKT    &kp RBKT                        &trans      &trans      
                                                        &kp RPAR                        &trans      
            >;
        };

        funcl {
            display-name = "fun";
            bindings = <
&trans    &trans    &kp F7    &kp F8     &kp F9     &kp F12                          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LC(PRINTSCREEN)
&trans    &trans    &kp F4    &kp F5     &kp F6     &kp F11                          &trans        &trans        &trans        &trans        &trans        &kp LC(LS(ESC))
&trans    &trans    &kp F1    &kp F2     &kp F3     &kp F10                          &bt BT_CLR    &trans        &trans        &trans        &trans        &trans                                                                
                                         &kp F10    &kp F11                          &trans        &trans        
                                                    &kp LS(F11)                      &trans        
            >;
        };

        lower {
// commented layout is not actual layout.
// -------------------------------------------------------------------------------------------------------------------------
// |   esc   |    1    |    2    |    3    |    4    |    5    |                   |    6    |    7    |    8    |    9    |    0    |  bspc   |
// |   tab   |    q    |    w    |    e    |    r    |    t    |                   |    y    |    u    |    i    |    o    |    p    |    \    |
// |  lalt   |    a    |    s    |    d    |    f    |    g    |                   |    h    |    j    |    k    |    l    |    ;    |    '    |
// |  lctrl  |    z    |    x    |    c    |    v    |    b    |                   |    n    |    m    |    ,    |    .    |    /    |  ralt   |
//                     |    [    |    ]    |                                                           |    -   |    =    |
//                               | mo lay 1| space   |                   | enter   | mo lay 2|
//                                         |   tab   |   home  |   end   |   del   |
//                                         |  raise  |    ~    |   gui   |  lower  |
            bindings = <
&trans     &trans     &kp K_PREV &kp K_PP   &kp K_NEXT &kp C_VOL_UP                    &kp K_CALC &kp KP_NUM &kp INS    &kp SLCK   &trans      &kp F12
&trans     &kp LEFT   &kp UP     &kp DOWN   &kp RIGHT  &kp C_VOL_DN                    &trans     &kp H      &kp J      &kp K      &kp L       &trans
&trans     &trans     &trans     &trans     &trans     &kp C_MUTE                      &trans     &trans     &trans     &trans     &trans      &trans                                                    
                                            &trans     &trans                          &trans     &trans     
                                                       &trans                          &trans     
            >;
        };
   };
};
